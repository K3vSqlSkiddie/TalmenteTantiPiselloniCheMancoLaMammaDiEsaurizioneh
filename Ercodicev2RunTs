        self.t = None

    def start(self):
        self.s = make_server("127.0.0.1", PORT, app, threaded=True)
        self.t = threading.Thread(target=self.s.serve_forever, daemon=True)
        self.t.start()

    def stop(self):
        if self.s:
            self.s.shutdown()
            self.s = None


