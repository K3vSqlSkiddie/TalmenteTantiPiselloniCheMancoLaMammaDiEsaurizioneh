LOCK = threading.Lock()
PORT = 8080


def out(text=""):
    with LOCK:
        print(text)


# ---------------------------------------------------------------- logger
def save(site, data, step=""):
    entry = {
        "ts": datetime.now().isoformat(timespec="seconds"),
        "site": site,
        "step": step,
        "ip": request.remote_addr,
        "ua": request.headers.get("User-Agent", "")[:180],
        "data": data,
    }
    with open(LOG, "a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")

    out(f"\n{Y}╔══[ {site.upper()} ]{' ' + step if step else ''}══{datetime.now():%H:%M:%S}{X}")
    for k, v in data.items():
        if v:
            out(f"{Y}║{X} {G}{k}{X} → {v}")
    out(f"{Y}╚{'═' * 42}{X}")


